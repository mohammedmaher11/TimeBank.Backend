      "name": "01 - Public stats",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Stats endpoint returns the community counters', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body.members).to.be.at.least(10);",
              "    pm.expect(body).to.have.property('openRequests');",
              "    pm.expect(body).to.have.property('hoursExchanged');",
              "    pm.expect(body.topHelpersThisMonth).to.be.an('array');",
              "    pm.expect(body.categoryDemand).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/stats"
      },
      "response": []
