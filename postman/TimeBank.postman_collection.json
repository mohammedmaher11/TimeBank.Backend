            "type": "text/javascript",
            "exec": [
              "pm.test('Categories are seeded with their skills', function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.be.an('array');",
              "    pm.expect(body.length).to.be.at.least(10);",
              "    const homeRepair = body.find(c => c.name === 'Home Repair');",
              "    pm.expect(homeRepair, 'Home Repair category').to.exist;",
              "    pm.expect(homeRepair.skills.length).to.be.greaterThan(0);",
              "    pm.collectionVariables.set('categoryId', homeRepair.id);",
              "});"
