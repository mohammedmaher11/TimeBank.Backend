{
  "info": {
    "_postman_id": "8f4d3b1e-6a2c-4c7e-9b1a-2f6d8e0c4a11",
    "name": "TimeBank Backend",
    "description": "End-to-end collection for the TimeBank API. Run the whole collection in order. It creates two fresh members per run, completes one exchange, checks balances, reviews, suspension with an old JWT, moderator category CRUD, and audit logging. Start the API first (see README) and make sure the database is seeded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// A new run id is generated when the collection starts at '00 - Health'.",
          "// This keeps emails and category names unique across repeated Collection Runner runs.",
          "const isStart = pm.info.requestName === '00 - Health';",
          "if (isStart || !pm.collectionVariables.get('runId')) {",
          "    const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}`;",
          "    pm.collectionVariables.set('runId', runId);",
          "    pm.collectionVariables.set('requesterEmail', `timebank.requester.${runId}@example.test`);",
          "    pm.collectionVariables.set('helperEmail', `timebank.helper.${runId}@example.test`);",
          "    pm.collectionVariables.set('categoryName', `Postman Category ${runId}`);",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "password", "value": "Test@2026!" },
    { "key": "moderatorEmail", "value": "mona.adel@sa3a.test" },
    { "key": "moderatorPassword", "value": "Sa3a@2026" },
    { "key": "neededBy", "value": "2026-12-31" },
    { "key": "requestedHours", "value": "1.5" },
    { "key": "categoryId", "value": "1" },
    { "key": "runId", "value": "" },
    { "key": "requesterEmail", "value": "" },
    { "key": "helperEmail", "value": "" },
    { "key": "categoryName", "value": "" }
